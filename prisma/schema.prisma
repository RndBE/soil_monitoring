generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusRisiko {
  NORMAL
  WASPADA
  SIAGA
  AWAS
}

enum JenisSaluran {
  PRIMER
  SEKUNDER
  TERSIER
}

enum JenisTitik {
  AWLR
  DEBIT
  PINTU_AIR
  CUACA_TANAH
}

enum JenisPerangkat {
  AWLR
  FLOW_METER
  AKTUATOR_PINTU
  WEATHER_STATION
  SOIL_SENSOR
  LOGGER
}

enum StatusPerangkat {
  ONLINE
  WEAK
  OFFLINE
  MAINTENANCE
}

enum ModePintuAir {
  MANUAL
  OTOMATIS
  TERJADWAL
}

enum StatusEvent {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SumberAktuasi {
  MANUAL
  JADWAL
  ALARM
  OVERRIDE
}

enum StatusLaporan {
  QUEUED
  READY
  FAILED
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  access    String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DaerahIrigasi {
  id              String            @id @default(cuid())
  nama            String            @unique
  kabupaten       String
  provinsi        String
  luasBakuSawahHa Float
  sumberAir       String
  deskripsi       String?
  saluran         Saluran[]
  titik           TitikMonitoring[]
  pintuAir        PintuAir[]
  alarms          Alarm[]
  events          Event[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Saluran {
  id              String            @id @default(cuid())
  kode            String            @unique
  nama            String
  jenis           JenisSaluran
  panjangM        Float
  kapasitasM3s    Float
  daerahIrigasiId String
  daerahIrigasi   DaerahIrigasi     @relation(fields: [daerahIrigasiId], references: [id])
  parentId        String?
  parent          Saluran?          @relation("SaluranHierarchy", fields: [parentId], references: [id])
  children        Saluran[]         @relation("SaluranHierarchy")
  titik           TitikMonitoring[]
  pintuAir        PintuAir[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([daerahIrigasiId])
  @@index([parentId])
}

model TitikMonitoring {
  id              String              @id @default(cuid())
  kode            String              @unique
  nama            String
  jenis           JenisTitik
  latitude        Float
  longitude       Float
  daerahIrigasiId String
  daerahIrigasi   DaerahIrigasi       @relation(fields: [daerahIrigasiId], references: [id])
  saluranId       String?
  saluran         Saluran?            @relation(fields: [saluranId], references: [id])
  status          StatusRisiko        @default(NORMAL)
  nilaiTerakhir   String?
  lastUpdate      DateTime
  perangkat       Perangkat[]
  mukaAirReadings MukaAirReading[]
  debitReadings   DebitReading[]
  cuacaReadings   CuacaTanahReading[]
  alarms          Alarm[]
  thresholds      TitikThreshold[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([daerahIrigasiId])
  @@index([saluranId])
  @@index([jenis])
  @@index([status])
}

model PintuAir {
  id              String            @id @default(cuid())
  kode            String            @unique
  nama            String
  latitude        Float
  longitude       Float
  daerahIrigasiId String
  daerahIrigasi   DaerahIrigasi     @relation(fields: [daerahIrigasiId], references: [id])
  saluranId       String?
  saluran         Saluran?          @relation(fields: [saluranId], references: [id])
  lebarM          Float
  tinggiM         Float
  kapasitasM3s    Float
  posisiPersen    Float             @default(0)
  mode            ModePintuAir      @default(MANUAL)
  status          StatusRisiko      @default(NORMAL)
  lastUpdate      DateTime
  perangkat       Perangkat[]
  aktuasi         AktuasiPintuAir[]
  jadwal          JadwalPintuAir[]
  alarms          Alarm[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([daerahIrigasiId])
  @@index([saluranId])
  @@index([status])
}

model Perangkat {
  id               String                 @id @default(cuid())
  kode             String                 @unique
  nama             String
  jenis            JenisPerangkat
  status           StatusPerangkat        @default(ONLINE)
  battery          Int
  signal           Int
  solarCharging    Boolean                @default(true)
  firmwareVersion  String?
  sensorStatus     String?
  lastDataReceived DateTime
  titikId          String?
  titik            TitikMonitoring?       @relation(fields: [titikId], references: [id])
  pintuAirId       String?
  pintuAir         PintuAir?              @relation(fields: [pintuAirId], references: [id])
  maintenance      PerangkatMaintenance[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status])
  @@index([titikId])
  @@index([pintuAirId])
}

model MukaAirReading {
  id         String          @id @default(cuid())
  titikId    String
  titik      TitikMonitoring @relation(fields: [titikId], references: [id])
  recordedAt DateTime
  tinggiM    Float
  waspadaM   Float
  siagaM     Float
  awasM      Float
  createdAt  DateTime        @default(now())

  @@index([titikId, recordedAt])
}

model DebitReading {
  id          String          @id @default(cuid())
  titikId     String
  titik       TitikMonitoring @relation(fields: [titikId], references: [id])
  recordedAt  DateTime
  debitM3s    Float
  kecepatanMs Float?
  createdAt   DateTime        @default(now())

  @@index([titikId, recordedAt])
}

model CuacaTanahReading {
  id                 String          @id @default(cuid())
  titikId            String
  titik              TitikMonitoring @relation(fields: [titikId], references: [id])
  recordedAt         DateTime
  curahHujanMm       Float?
  suhuC              Float?
  kelembabanUdaraPct Float?
  kelembabanTanahPct Float?
  evapotranspirasiMm Float?
  kecepatanAnginMs   Float?
  createdAt          DateTime        @default(now())

  @@index([titikId, recordedAt])
}

model AktuasiPintuAir {
  id                  String        @id @default(cuid())
  pintuAirId          String
  pintuAir            PintuAir      @relation(fields: [pintuAirId], references: [id])
  waktu               DateTime
  posisiSebelumPersen Float
  posisiSesudahPersen Float
  sumber              SumberAktuasi
  operator            String?
  catatan             String?
  createdAt           DateTime      @default(now())

  @@index([pintuAirId, waktu])
}

model JadwalPintuAir {
  id                 String   @id @default(cuid())
  pintuAirId         String
  pintuAir           PintuAir @relation(fields: [pintuAirId], references: [id])
  nama               String
  hariMingguMask     Int      @default(127)
  jamMulai           String
  jamSelesai         String
  posisiTargetPersen Float
  aktif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([pintuAirId])
}

model Alarm {
  id              String           @id @default(cuid())
  kode            String           @unique
  jenis           String
  daerahIrigasiId String
  daerahIrigasi   DaerahIrigasi    @relation(fields: [daerahIrigasiId], references: [id])
  titikId         String?
  titik           TitikMonitoring? @relation(fields: [titikId], references: [id])
  pintuAirId      String?
  pintuAir        PintuAir?        @relation(fields: [pintuAirId], references: [id])
  status          StatusRisiko
  state           StatusEvent      @default(OPEN)
  pesan           String
  occurredAt      DateTime
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([daerahIrigasiId])
  @@index([titikId])
  @@index([pintuAirId])
  @@index([status])
  @@index([state])
}

model Event {
  id              String        @id @default(cuid())
  judul           String
  daerahIrigasiId String
  daerahIrigasi   DaerahIrigasi @relation(fields: [daerahIrigasiId], references: [id])
  status          StatusRisiko
  state           StatusEvent   @default(OPEN)
  occurredAt      DateTime
  catatan         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([daerahIrigasiId])
  @@index([status])
}

model PerangkatMaintenance {
  id          String      @id @default(cuid())
  perangkatId String
  perangkat   Perangkat   @relation(fields: [perangkatId], references: [id])
  teknisi     String
  scheduledAt DateTime
  catatan     String
  state       StatusEvent @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([perangkatId])
  @@index([state])
}

model LaporanTemplate {
  id        String    @id
  nama      String
  periode   String
  audience  String
  formats   Json
  laporan   Laporan[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Laporan {
  id          String          @id @default(cuid())
  templateId  String
  template    LaporanTemplate @relation(fields: [templateId], references: [id])
  daerahNama  String
  status      StatusLaporan   @default(QUEUED)
  downloadUrl String?
  generatedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([templateId])
  @@index([status])
}

model Threshold {
  id        String   @id
  metric    String
  normal    String
  waspada   String
  siaga     String
  awas      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TitikThreshold {
  id        String          @id @default(cuid())
  titikId   String
  titik     TitikMonitoring @relation(fields: [titikId], references: [id], onDelete: Cascade)
  parameter String
  unit      String
  normal    Float
  waspada   Float
  siaga     Float
  awas      Float
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([titikId, parameter])
  @@index([titikId])
}

model BobotRisiko {
  id        String   @id
  metric    String
  weight    Int
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
