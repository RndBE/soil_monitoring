# Koneksi MySQL Prisma
DATABASE_URL="mysql://user:password@localhost:3306/soil_monitoring"

# Kunci tanda tangan cookie sesi — WAJIB, minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kalau diganti, semua sesi yang sedang aktif langsung tidak berlaku.
AUTH_SECRET=""

# NASA FIRMS MAP_KEY untuk hotspot VIIRS di /fire-risk — OPSIONAL.
# Kosong = pakai file CSV publik FIRMS (48 jam). Diisi = Area API (72 jam).
# Minta gratis di https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=""
